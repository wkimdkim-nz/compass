#!/bin/sh
# Runs before every commit once `git config core.hooksPath .githooks` is set (README, "Running it
# locally"). GitHub cannot protect main on this repo's plan, so this is the guard.

branch=$(git branch --show-current)
if [ "$branch" = "main" ]; then
  echo "pre-commit: refusing to commit on main. Create a branch first: git switch -c <name>" >&2
  exit 1
fi

# claude/* is the name the Claude desktop app gives its worktree branches. An empty name is a
# detached HEAD, as in the middle of a rebase.
types='feat|fix|docs|chore|refactor|ci|research|prototype'
if [ -n "$branch" ] && ! echo "$branch" | grep -Eq "^(($types)/[a-z0-9]+(-[a-z0-9]+)*|claude/.+)$"; then
  echo "pre-commit: branch '$branch' does not match <type>/<slug>, with <type> one of" >&2
  echo "  $(echo "$types" | sed 's/|/, /g'). Issue work is <type>/issue-<N>-<slug>. Rename: git branch -m <name>" >&2
  exit 1
fi

if git diff --cached --name-only | grep -q '^web/'; then
  if [ ! -d web/node_modules ]; then
    echo "pre-commit: web/node_modules is missing; run npm ci in web/ before committing." >&2
    exit 1
  fi

  # Typecheck a copy of the staged web/ files, so unstaged edits in the working tree can neither
  # hide a broken commit nor block a good one.
  staged=$(mktemp -d)
  trap 'rm -rf "$staged"' EXIT
  git ls-files -z -- web | xargs -0 git checkout-index --prefix="$staged/" --
  ln -s "$PWD/web/node_modules" "$staged/web/node_modules"
  if ! npm --prefix "$staged/web" run --silent typecheck; then
    echo "pre-commit: the staged web typecheck failed; fix it before committing." >&2
    exit 1
  fi
fi
