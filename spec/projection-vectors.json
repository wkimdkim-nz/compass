      "working": [
        "1.25^5: 1.5625, 1.953125, 2.44140625, 3.0517578125. future_revenue = 500,000,000 x 3.0517578125 = 1,525,878,906.25",
        "future_net_income = 1,525,878,906.25 x 0.08 = 122,070,312.5 (computed, not used: ps path)",
        "1.05^5: 1.1025, 1.157625, 1.21550625, 1.2762815625. future_shares = 50,000,000 x 1.2762815625 = 63,814,078.125",
        "future_market_cap = 1,525,878,906.25 x 6 = 9,155,273,437.5",
        "futurePrice = 9,155,273,437.5 / 63,814,078.125 = 143.46792598909772",
        "x = 143.46792598909772 / 60 = 2.3911320998182954",
        "cagr = x^(1/5) - 1 = 0.19047619047619048"
      ],
      "closedForm": "Revenue per share 10 at P/S 6 prices the share at 60, so x = (1.25/1.05)^5 = (25/21)^5 = 9765625/4084101. cagr = 25/21 - 1 = 4/21.",
      "intermediates": {
        "futureRevenue": 1525878906.25,
        "futureNetIncome": 122070312.5,
        "futureShares": 63814078.125,
        "futureMarketCap": 9155273437.5
      },
      "expected": {
        "futurePrice": 143.46792598909772,
        "x": 2.3911320998182954,
        "cagr": 0.19047619047619048
      }
    },
    {
      "id": "pe-zero-growth-5y",
      "description": "Zero revenue growth with 2% dilution over five years: the share count grows, the price shrinks, CAGR is negative.",
      "inputs": {
        "currentPrice": 20,
