    {
      "id": "pe-one-year-compression",
      "description": "One-year horizon with multiple compression: 30% growth cannot outrun the P/E falling from an implied 41.7 to 25. With horizon 1, cagr must equal x - 1 exactly.",
      "inputs": {
        "currentPrice": 50,
        "ttmRevenue": 1000000000,
        "dilutedShares": 100000000,
        "growthRate": 0.3,
        "futureNetMargin": 0.12,
        "exitMultiple": { "kind": "pe", "value": 25 },
        "dilutionRate": 0.04,
        "horizon": 1
      },
      "working": [
        "future_revenue = 1,000,000,000 x 1.3 = 1,300,000,000",
        "future_net_income = 1,300,000,000 x 0.12 = 156,000,000",
        "future_shares = 100,000,000 x 1.04 = 104,000,000",
        "future_market_cap = 156,000,000 x 25 = 3,900,000,000",
        "futurePrice = 3,900,000,000 / 104,000,000 = 37.5",
        "x = 37.5 / 50 = 0.75",
        "cagr = 0.75^(1/1) - 1 = -0.25"
      ],
      "closedForm": "Future EPS 1.5 x 25 = 37.5; x = 3/4; over one year cagr = x - 1 = -1/4.",
      "intermediates": {
        "futureRevenue": 1300000000,
        "futureNetIncome": 156000000,
        "futureShares": 104000000,
        "futureMarketCap": 3900000000
      },
      "expected": {
        "futurePrice": 37.5,
        "x": 0.75,
        "cagr": -0.25
      }
