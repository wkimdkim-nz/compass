{
  "title": "Compass projection vectors",
  "formula": "docs/glossary.md, section 'The core formula'. future_revenue = ttmRevenue x (1+growthRate)^horizon; future_net_income = future_revenue x futureNetMargin; future_shares = dilutedShares x (1+dilutionRate)^horizon; future_market_cap = future_net_income x exitMultiple.value when kind is pe, or future_revenue x exitMultiple.value when kind is ps; futurePrice = future_market_cap / future_shares; x = futurePrice / currentPrice; cagr = x^(1/horizon) - 1.",
  "purpose": "Hand-computed cases that both calculators (the .NET one, authoritative on save, and the TypeScript one, live preview) assert against, so the two cannot drift (ADR 0004, amended 2026-09-17). If the glossary prose and this file disagree, this file is wrong until a case is re-derived by hand.",
  "units": {
    "currentPrice": "currency per share, as quoted",
    "ttmRevenue": "currency, raw (not millions)",
    "dilutedShares": "shares, raw (not millions); the diluted weighted average",
    "growthRate": "decimal per year (0.10 = 10%)",
    "futureNetMargin": "decimal (0.20 = 20%); ignored on the ps path",
    "exitMultiple": "object { kind: 'pe' | 'ps', value: number }. pe applies to future net income, ps to future revenue. A discriminated kind, never a bare number.",
    "dilutionRate": "decimal per year; negative for a buyback",
    "horizon": "whole years, >= 1",
    "note": "Decimals on the wire is the rule (ADR 0004, amended). Whole-number percents and millions belong to the UI only."
  },
  "tolerance": {
    "relative": 1e-9,
    "rule": "For each of futurePrice, x and cagr: |actual - expected| <= 1e-9 x max(1, |expected|). Both calculators compute in double; expected values here are decimal expansions of exact rationals, written to at least 16 significant digits."
  },
  "how-to-read-a-case": "Every case is designed so the horizon-th root in the CAGR is exact: with the exit multiple equal to the multiple implied by the current price, X = ((1+g)/(1+d))^horizon and CAGR = (1+g)/(1+d) - 1 = (g-d)/(1+d); when the multiple changes, the case uses a horizon of 1 or 2, or a multiple ratio that is itself a perfect fifth power, so the root is still rational. 'working' walks the glossary formula line by line; 'closedForm' is the shortcut a reviewer can check the outputs against without a calculator.",
  "cases": [
    {
      "id": "pe-base-5y",
      "description": "Five-year base case on the P/E path: 10% growth, 20% future margin, 2% dilution, exit P/E 20. Worked by hand.",
      "inputs": {
        "currentPrice": 40,
        "ttmRevenue": 1000000000,
        "dilutedShares": 100000000,
        "growthRate": 0.1,
        "futureNetMargin": 0.2,
        "exitMultiple": { "kind": "pe", "value": 20 },
        "dilutionRate": 0.02,
        "horizon": 5
      },
      "working": [
        "1.1^5: 1.21, 1.331, 1.4641, 1.61051. future_revenue = 1,000,000,000 x 1.61051 = 1,610,510,000",
        "future_net_income = 1,610,510,000 x 0.20 = 322,102,000",
        "1.02^5: 1.02^2 = 1.0404; 1.0404^2 = 1.08243216; x 1.02 = 1.1040808032. future_shares = 110,408,080.32",
        "future_market_cap = 322,102,000 x 20 = 6,442,040,000",
        "futurePrice = 6,442,040,000 / 110,408,080.32 = 58.347541061567114",
        "x = 58.347541061567114 / 40 = 1.4586885265391779",
        "cagr = x^(1/5) - 1 = 0.078431372549019608"
      ],
      "closedForm": "Current EPS 2 at P/E 20 prices the share at 40, so the exit multiple equals the current one and x = (1.1/1.02)^5 = (55/51)^5 = 503284375/345025251. cagr = 55/51 - 1 = 4/51.",
      "intermediates": {
        "futureRevenue": 1610510000,
        "futureNetIncome": 322102000,
        "futureShares": 110408080.32,
        "futureMarketCap": 6442040000
      },
      "expected": {
        "futurePrice": 58.347541061567114,
        "x": 1.4586885265391779,
        "cagr": 0.078431372549019608
      }
    },
    {
      "id": "ps-base-5y",
