        "1.25^2 = 1.5625. future_shares = 20,000,000 x 1.5625 = 31,250,000",
        "future_market_cap = 256,000,000 x 4 = 1,024,000,000",
        "futurePrice = 1,024,000,000 / 31,250,000 = 32.768",
