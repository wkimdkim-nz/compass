.DS_Store
.codex/config.toml

# Local secrets and captured provisioning values
.env
.env.*
!.env.example

# Build output
bin/
obj/
node_modules/
dist/
*.tsbuildinfo

# Terraform — state describes the infrastructure in detail and never enters git.
# `.terraform.lock.hcl` is deliberately NOT ignored: the provider versions are part of the build.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
crash.log

# Impeccable per-machine settings
.impeccable/config.local.json
